+import type { FastifyCorsOptions } from "@fastify/cors";
+
+export function normalizedWebOrigin(value: string, production: boolean): string {
+  const url = new URL(value);
+  if (url.username || url.password || url.search || url.hash || url.pathname !== "/" || !["https:", "http:"].includes(url.protocol) || (production && url.protocol !== "https:")) {
+    throw new Error("WEB_APP_ORIGIN doit être une origine HTTPS sans chemin, identifiants, paramètres ni fragment.");
+  }
+  return url.origin;
+}
+
+export function browserCorsOptions(mode: string, webOrigin: string): FastifyCorsOptions {
+  const origin = normalizedWebOrigin(webOrigin, mode === "production");
+  return {
+    origin: mode === "production" ? [origin] : true,
+    methods: ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"],
+    allowedHeaders: ["Accept", "Authorization", "Content-Type", "If-Match", "If-None-Match", "X-Workspace-Client", "Cache-Control"],
+    exposedHeaders: ["ETag", "X-Next-Cursor", "Retry-After"],
+    credentials: false,
+    maxAge: 600,
+    strictPreflight: true
+  };
+}
