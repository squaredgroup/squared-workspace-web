diff --git a/Backend/tests/web-browser-policy.test.mjs b/Backend/tests/web-browser-policy.test.mjs
new file mode 100644
--- /dev/null
+++ b/Backend/tests/web-browser-policy.test.mjs
@@ -0,0 +1,13 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import Fastify from 'fastify';
+import cors from '@fastify/cors';
+import {browserCorsOptions,normalizedWebOrigin} from '../dist/src/web-browser-policy.js';
+const origin='https://workspace.app.squaredgroup.studio';
+async function server(){const app=Fastify();await app.register(cors,browserCorsOptions('production',origin));app.get('/health',()=>({ok:true}));app.get('/private',(_req,reply)=>reply.code(401).send({error:'unauthorized'}));return app;}
+test('official Web origin accepts login preflight',async()=>{const app=await server();try{const r=await app.inject({method:'OPTIONS',url:'/v1/auth/password',headers:{origin,'access-control-request-method':'POST','access-control-request-headers':'content-type,x-workspace-client'}});assert.equal(r.statusCode,204);assert.equal(r.headers['access-control-allow-origin'],origin);assert.match(r.headers['access-control-allow-headers'],/X-Workspace-Client/i);}finally{await app.close();}});
+test('official origin accepts PATCH, DELETE and revision headers',async()=>{const app=await server();try{for(const method of ['PATCH','DELETE']){const r=await app.inject({method:'OPTIONS',url:'/v1/projects',headers:{origin,'access-control-request-method':method,'access-control-request-headers':'authorization,if-match'}});assert.equal(r.statusCode,204);assert.match(r.headers['access-control-allow-methods'],new RegExp(method));assert.match(r.headers['access-control-allow-headers'],/If-Match/i);}}finally{await app.close();}});
+test('untrusted and deceptive origins never receive CORS approval',async()=>{const app=await server();try{for(const bad of ['https://other.invalid',origin+'.evil.invalid','null']){const r=await app.inject({method:'OPTIONS',url:'/v1/auth/password',headers:{origin:bad,'access-control-request-method':'POST'}});assert.equal(r.headers['access-control-allow-origin'],undefined);}}finally{await app.close();}});
+test('native requests without Origin still work',async()=>{const app=await server();try{const r=await app.inject({method:'GET',url:'/health'});assert.equal(r.statusCode,200);}finally{await app.close();}});
+test('CORS never grants authenticated access',async()=>{const app=await server();try{const r=await app.inject({method:'GET',url:'/private',headers:{origin}});assert.equal(r.statusCode,401);assert.equal(r.headers['access-control-allow-origin'],origin);}finally{await app.close();}});
+test('unsafe production origin configuration is rejected',()=>{for(const bad of ['http://example.com','https://user:pass@example.com','https://example.com/path','https://example.com/?x=y'])assert.throws(()=>normalizedWebOrigin(bad,true));assert.equal(normalizedWebOrigin(origin+'/',true),origin);});
